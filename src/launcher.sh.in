#!/bin/sh
# Generated by zellij-ai-resume install.sh @VERSION@; edit src/launcher.sh.in and re-run the installer.
#
# z@TOOL@: run @TOOL@ so that Zellij can bring the conversation back after the
# session dies (crash, reboot, kill -9). Outside Zellij it is plain @TOOL@.
#
# Zellij saves the command of every pane and offers to run it again when the
# session is resurrected. For a pane started with this launcher that command is
#     /bin/sh @SELF@ --zj-pane <token>
# which is why this is a /bin/sh script (a Python interpreter's path carries
# its version and changes on upgrade) and why it waits for the CLI instead of
# exec'ing it: Zellij saves whatever runs in the foreground of the pane.
ZJR_PYTHON='@PYTHON@'
ZJR_CORE='@CORE@'

# The Python chosen at install time; if it has gone (upgraded, uninstalled),
# another 3.8+; without one, the plain CLI rather than nothing at all.
if [ ! -x "$ZJR_PYTHON" ]; then
    ZJR_PYTHON=
    for candidate in /usr/bin/python3 python3; do
        # macOS's /usr/bin/python3 opens an installer dialog without the Command Line Tools.
        if [ "$candidate" = /usr/bin/python3 ] && [ "$(uname -s)" = Darwin ] &&
            ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
            continue
        fi
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -I -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
            ZJR_PYTHON=$candidate
            break
        fi
    done
fi
if [ -z "$ZJR_PYTHON" ] || [ ! -f "$ZJR_CORE" ]; then
    echo "[z@TOOL@] no Python 3.8+ or $ZJR_CORE is missing; starting @TOOL@ without recovery" >&2
    case ${ZJR_SH_HOPS-} in
        xxx*) echo "[z@TOOL@] @TOOL@ on PATH leads back here; fix PATH" >&2; exit 126 ;;
    esac
    ZJR_SH_HOPS=${ZJR_SH_HOPS-}x
    export ZJR_SH_HOPS
    [ "${1-}" = --zj-pane ] && set --
    exec @TOOL@ "$@"
fi

if [ "${1-}" = --zj-pane ]; then
    # Ctrl+C reaches the whole foreground job and the CLI handles it. A shell
    # runs a trap only once the foreground command has exited, so this keeps
    # the pane's process alive for exactly as long as the CLI.
    trap : INT QUIT
    "$ZJR_PYTHON" -I "$ZJR_CORE" run @TOOL@ '@SELF@' "$@"
    exit $?
fi
exec "$ZJR_PYTHON" -I "$ZJR_CORE" start @TOOL@ '@SELF@' "$@"
